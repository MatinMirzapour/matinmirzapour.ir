    navMenu.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", () => {
        if (window.innerWidth <= 720) {
          navMenu.classList.remove("open");
        }
      });
    });

    // اطمینان از نمایش درست در دسکتاپ بعد از تغییر سایز
    window.addEventListener("resize", () => {
      if (window.innerWidth > 720) {
        navMenu.classList.remove("open");
      }
    });
  }

  // --- منطق شبه SPA برای منو ---
  const sections = document.querySelectorAll("[data-section]");
  const navLinks = document.querySelectorAll("[data-nav]");

  function showAllSections() {
    sections.forEach(sec => {
      if (sec.dataset.section === "hero" || sec.dataset.section === "store") {
        sec.classList.remove("hidden");
      } else {
        sec.classList.add("hidden");
      }
    });
    window.scrollTo({ top: 0, behavior: "smooth" });
    setActiveNav("home");
  }

  function showSingleSection(sectionName) {
    sections.forEach(sec => {
      if (sec.dataset.section === sectionName) {
        sec.classList.remove("hidden");
      } else {
        sec.classList.add("hidden");
      }
    });
    window.scrollTo({ top: 0, behavior: "smooth" });
    setActiveNav(sectionName);
  }

  function goToSection(sectionName) {
    showSingleSection(sectionName);
  }

  function setActiveNav(target) {
    navLinks.forEach(link => {
      if (link.dataset && link.dataset.nav) {
        link.classList.toggle("active", link.dataset.nav === target);
      }
    });
  }

  navLinks.forEach(link => {
    link.addEventListener("click", (e) => {
      const target = link.dataset.nav;
      if (!target) return;
      e.preventDefault();
      if (target === "home") {
        showAllSections();
      } else {
        showSingleSection(target);
      }
    });
