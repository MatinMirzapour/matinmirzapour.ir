        <div class="product-meta">${p.description}</div>
        <div class="product-footer">
          <div class="product-price">${formatPrice(p.price)}</div>
          <button class="product-add" type="button" onclick="addToCart(${p.id})">افزودن</button>
        </div>
      `;
      list.appendChild(div);
    });
  }

  function addToCart(id) {
    const product = products.find(p => p.id === id);
    if (!product) return;
    const existing = cart.find(item => item.id === id);
    if (existing) {
      existing.qty += 1;
    } else {
      cart.push({ id: product.id, name: product.name, price: product.price, qty: 1 });
    }
    renderCart();
  }

  function changeQty(id, delta) {
    const item = cart.find(i => i.id === id);
    if (!item) return;
    item.qty += delta;
    if (item.qty <= 0) {
      cart = cart.filter(i => i.id !== id);
    }
    renderCart();
  }

  function renderCart() {
    const container = document.getElementById("cart-items");
    const subtotalEl = document.getElementById("cart-subtotal");
    const totalEl = document.getElementById("cart-total");
    const countEl = document.getElementById("cart-count");
    const discountEl = document.getElementById("cart-discount");
    const discountLine = document.getElementById("cart-discount-line");

    if (!container || !subtotalEl || !totalEl || !countEl) return;

    container.innerHTML = "";
    if (cart.length === 0) {
      container.innerHTML = "<div class='cart-note'>سبد خرید خالی است.</div>";
      subtotalEl.textContent = formatPrice(0);
      totalEl.textContent = formatPrice(0);
      countEl.textContent = "۰ آیتم";
      if (discountLine) discountLine.style.display = "none";
      return;
    }

    let total = 0;
    let count = 0;

    cart.forEach(item => {
      total += item.price * item.qty;
      count += item.qty;
      const row = document.createElement("div");
      row.className = "cart-item";
      row.innerHTML = `
        <div class="cart-item-name">${item.name}</div>
        <div class="cart-item-controls">
          <button class="cart-btn" type="button" onclick="changeQty(${item.id}, 1)">+</button>
          <span>${item.qty}</span>
          <button class="cart-btn" type="button" onclick="changeQty(${item.id}, -1)">−</button>
        </div>
      `;
      container.appendChild(row);
    });

    const discountAmountBase = currentDiscountPercent > 0 ? Math.round(total * currentDiscountPercent / 100) : 0;
    const payableBase = total - discountAmountBase;

    subtotalEl.textContent = formatPrice(total);
    totalEl.textContent = formatPrice(payableBase);
    countEl.textContent = count.toLocaleString("fa-IR") + " آیتم";

    if (discountLine && discountEl) {
      if (discountAmountBase > 0) {
        discountEl.textContent = formatPrice(discountAmountBase);
        discountLine.style.display = "block";
      } else {
        discountLine.style.display = "none";
      }
    }
  }

  function applyDiscount() {
    const input = document.getElementById("discount-code");
    const msg = document.getElementById("discount-message");
    if (!input || !msg) return;

    const code = input.value.trim().toUpperCase();
    if (!code) {
      msg.textContent = "لطفاً کد تخفیف را وارد کنید.";
      currentDiscountPercent = 0;
      currentDiscountCode = null;
      renderCart();
      return;
    }

    const discountMap = {
      "MATIN10": 10,
      "MATIN20": 20
    };

    if (discountMap[code]) {
      currentDiscountPercent = discountMap[code];
      currentDiscountCode = code;
      msg.textContent = "کد تخفیف اعمال شد: " + discountMap[code] + "٪";
    } else {
      currentDiscountPercent = 0;
      currentDiscountCode = null;
      msg.textContent = "کد تخفیف نامعتبر است.";
    }

    renderCart();
  }

  // Filter buttons
  document.querySelectorAll(".filter-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".filter-btn").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      currentFilter = btn.dataset.filter;
      renderProducts();
      document.querySelectorAll("#product-list .fade").forEach(el => el.classList.add("visible"));
    });
  });

  // Customer type switch
  document.querySelectorAll(".customer-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".customer-btn").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      customerType = btn.dataset.customer === "intl" ? "intl" : "iran";
      renderProducts();
      renderCart();
      document.querySelectorAll("#product-list .fade").forEach(el => el.classList.add("visible"));
    });
  });

  // Auth tab switch
  document.querySelectorAll(".auth-tab").forEach(tab => {
    tab.addEventListener("click", () => {
      document.querySelectorAll(".auth-tab").forEach(t => t.classList.remove("active"));
      tab.classList.add("active");
      const mode = tab.dataset.mode;
      const emailGroup = document.getElementById("auth-email-group");
      const phoneGroup = document.getElementById("auth-phone-group");
      if (mode === "email") {
        emailGroup.style.display = "block";
        phoneGroup.style.display = "none";
      } else {
        emailGroup.style.display = "none";
        phoneGroup.style.display = "block";
      }
    });
  });

  function sendFakeOtp() {
    const msg = document.getElementById("auth-message");
    if (msg) {
      msg.textContent = "در نسخه نهایی، کد یکبارمصرف از طریق سرور برای ایمیل یا شماره شما ارسال خواهد شد. (اینجا فقط برای تست است.)";
    }
  }

  function fakeRegister() {
    const msg = document.getElementById("auth-message");
    if (msg) {
      msg.textContent = "ثبت‌نام نمونه با موفقیت انجام شد. در نسخه اصلی، اطلاعات شما در سرور ذخیره خواهد شد.";
    }
  }

  // وقتی صفحه کامل لود شد
  window.addEventListener("load", function () {
    showAllSections();
    renderProducts();
    renderCart();
    document.querySelectorAll(".fade").forEach(function (el) {
      el.classList.add("visible");
    });
  });
</script>

</body>
</html>
