  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    body {
      background: radial-gradient(circle at top, #020617 0, #020617 55%, #020617 100%);
      color: #e5e7eb;
      line-height: 1.9;
      scroll-behavior: smooth;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font-family: inherit;
    }

    /* انیمیشن fade-in */
    .fade {
      opacity: 0;
      transform: translateY(15px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }

    .fade.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .hover-lift {
      transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    }

    .hover-lift:hover {
      transform: translateY(-2px) scale(1.01);
      box-shadow: 0 18px 45px rgba(0, 0, 0, 0.7);
      border-color: #4b5563;
    }

    /* Header */
    header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(3, 7, 18, 0.96);
      backdrop-filter: blur(18px);
      border-bottom: 1px solid #111827;
    }

    .container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 16px;
    }

    .nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 0;
      gap: 10px;
    }

    .logo {
      font-weight: 800;
      font-size: 1.25rem;
      letter-spacing: 0.04em;
      white-space: nowrap;
      cursor: pointer;
    }

    .logo span {
      color: #a855f7;
    }

    nav {
      position: relative;
    }

    nav ul {
      list-style: none;
      display: flex;
      gap: 12px;
      font-size: 0.9rem;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    nav li a {
      padding: 6px 10px;
      border-radius: 999px;
      color: #9ca3af;
      transition: 0.2s;
      cursor: pointer;
      white-space: nowrap;
    }

    nav li a:hover,
    nav li a.active {
      background: linear-gradient(135deg, #6366f1, #a855f7);
      color: #f9fafb;
    }

    /* دکمه منوی موبایل */
    .nav-toggle {
      display: none;
      border: 1px solid #374151;
      background: #020617;
      color: #e5e7eb;
      border-radius: 999px;
      padding: 6px 10px;
      font-size: 0.85rem;
      cursor: pointer;
      align-items: center;
      gap: 6px;
    }

    .nav-toggle span {
      display: inline-block;
    }

    .nav-toggle-icon {
      width: 14px;
      height: 2px;
      background: #e5e7eb;
      position: relative;
      border-radius: 999px;
    }

    .nav-toggle-icon::before,
    .nav-toggle-icon::after {
      content: "";
      position: absolute;
      width: 14px;
      height: 2px;
      background: #e5e7eb;
      border-radius: 999px;
      right: 0;
    }

    .nav-toggle-icon::before {
      top: -4px;
    }

    .nav-toggle-icon::after {
      top: 4px;
    }

    @media (max-width: 720px) {
      .nav {
        align-items: center;
      }

      nav ul {
        position: absolute;
        top: 110%;
        right: 0;
        background: #020617;
        border-radius: 14px;
        border: 1px solid #111827;
        padding: 8px;
        flex-direction: column;
        align-items: flex-start;
        min-width: 170px;
        box-shadow: 0 18px 45px rgba(0, 0, 0, 0.8);
        display: none;
      }

      nav ul.open {
        display: flex;
      }

      .nav-toggle {
        display: inline-flex;
      }
    }

    main {
      padding-bottom: 40px;
    }

    /* Hero */
    .hero {
      padding: 40px 0 32px 0;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1.2fr);
      gap: 26px;
      align-items: center;
    }

    @media (max-width: 900px) {
      .hero-grid {
        grid-template-columns: minmax(0, 1fr);
        gap: 20px;
      }
    }

    .hero-kicker {
      font-size: 0.9rem;
      color: #9ca3af;
      margin-bottom: 6px;
    }

    .hero-title {
      font-size: clamp(2rem, 3vw, 2.5rem);
      font-weight: 800;
      margin-bottom: 12px;
    }

    .hero-subtitle {
      font-size: 0.98rem;
      color: #e5e7eb;
      margin-bottom: 18px;
      max-width: 640px;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 18px;
    }

    .btn-primary,
    .btn-ghost {
      border-radius: 999px;
      padding: 9px 18px;
      font-size: 0.9rem;
      border: 1px solid transparent;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: 0.18s ease;
    }

    .btn-primary {
      background: linear-gradient(135deg, #6366f1, #a855f7);
      color: #f9fafb;
      box-shadow: 0 14px 35px rgba(88, 28, 135, 0.55);
    }

    .btn-primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 20px 45px rgba(59, 130, 246, 0.6);
    }

    .btn-ghost {
      background: transparent;
      color: #e5e7eb;
      border-color: #4b5563;
    }

    .btn-ghost:hover {
      background: #0b1120;
      border-color: #818cf8;
    }

    .btn-small {
      font-size: 0.8rem;
      padding: 6px 12px;
    }

    .hero-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      font-size: 0.78rem;
      color: #cbd5f5;
    }

    .hero-tag {
      padding: 4px 10px;
      border-radius: 999px;
      border: 1px solid #4c1d95;
      background: rgba(30, 64, 175, 0.4);
      backdrop-filter: blur(10px);
    }

    .hero-card {
      background: radial-gradient(circle at top left, #4c1d95, #020617 60%);
      border-radius: 22px;
      border: 1px solid #4b5563;
      padding: 18px;
      box-shadow: 0 22px 55px rgba(15, 23, 42, 0.9);
      font-size: 0.92rem;
    }

    .hero-avatar {
      width: 68px;
      height: 68px;
      border-radius: 999px;
      background: conic-gradient(from 180deg, #6366f1, #a855f7, #f97316, #6366f1);
      padding: 3px;
      margin-bottom: 10px;
    }

    .hero-avatar-inner {
      width: 100%;
      height: 100%;
      border-radius: inherit;
      background: #020617;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
    }

    .hero-card h2 {
      font-size: 1.02rem;
      margin-bottom: 8px;
    }

    .hero-card p {
      margin-bottom: 8px;
      color: #e5e7eb;
    }

    .hero-card-list {
      list-style: none;
      font-size: 0.82rem;
      color: #d1fae5;
    }

    .hero-card-list li {
      display: flex;
      gap: 8px;
      margin-bottom: 6px;
    }

    .dot {
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background: #22c55e;
      margin-top: 6px;
      flex-shrink: 0;
    }

    /* Sections */
    section {
      padding: 30px 0;
    }

    .section-header {
      margin-bottom: 16px;
    }

    .section-kicker {
      font-size: 0.82rem;
      color: #9ca3af;
      margin-bottom: 4px;
    }

    .section-title {
      font-size: 1.4rem;
      font-weight: 700;
      margin-bottom: 4px;
    }

    .section-subtitle {
      font-size: 0.9rem;
      color: #e5e7eb;
      max-width: 700px;
    }

    /* Layout helpers */
    .grid-2 {
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: 18px;
    }

    @media (max-width: 900px) {
      .grid-2 {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .card {
      background: radial-gradient(circle at top left, #020617, #020617);
      border-radius: 16px;
      padding: 14px 14px 16px 14px;
      border: 1px solid #111827;
      box-shadow: 0 16px 40px rgba(15, 23, 42, 0.8);
      font-size: 0.9rem;
    }

    .card-title {
      font-weight: 600;
      margin-bottom: 6px;
      display: flex;
      gap: 6px;
      align-items: center;
      font-size: 0.95rem;
    }

    .card-title span.icon {
      font-size: 1.1rem;
    }

    .card-body {
      color: #e5e7eb;
    }

    .info-list {
      list-style: none;
      font-size: 0.9rem;
    }

    .info-list li {
      margin-bottom: 6px;
    }

    .info-label {
      color: #9ca3af;
      font-size: 0.82rem;
      display: inline-block;
      min-width: 100px;
    }

    .muted {
      font-size: 0.8rem;
      color: #9ca3af;
      margin-top: 4px;
    }

    /* Store */
    .store-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1.1fr);
      gap: 18px;
      align-items: flex-start;
    }

    @media (max-width: 900px) {
      .store-grid {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .customer-type {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      align-items: center;
      margin-bottom: 10px;
      font-size: 0.82rem;
      color: #e5e7eb;
    }

    .customer-label {
      color: #9ca3af;
    }

    .customer-btn {
      padding: 4px 10px;
      border-radius: 999px;
      border: 1px solid #374151;
      background: #020617;
      color: #e5e7eb;
      cursor: pointer;
      font-size: 0.8rem;
      transition: 0.15s;
    }

    .customer-btn.active,
    .customer-btn:hover {
      border-color: #22c55e;
      background: #022c22;
    }

    .product-filters {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 10px;
      font-size: 0.8rem;
    }

    .filter-btn {
      padding: 4px 10px;
      border-radius: 999px;
      border: 1px solid #374151;
      background: #020617;
      color: #e5e7eb;
      cursor: pointer;
      font-size: 0.8rem;
      transition: 0.15s;
    }

    .filter-btn.active,
    .filter-btn:hover {
      border-color: #818cf8;
      background: #111827;
    }

    .product-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    @media (max-width: 640px) {
      .product-list {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .product-card {
      background: radial-gradient(circle at top, #020617, #020617);
      border-radius: 14px;
      border: 1px solid #111827;
      padding: 10px 10px 12px 10px;
      font-size: 0.87rem;
    }

    .product-thumb {
      height: 60px;
      border-radius: 12px;
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.6rem;
      background: radial-gradient(circle at top, #1f2937, #020617);
    }

    .product-name {
      font-weight: 600;
      margin-bottom: 4px;
      font-size: 0.92rem;
    }

    .product-meta {
      font-size: 0.8rem;
      color: #d1d5db;
      margin-bottom: 4px;
    }

    .product-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 6px;
    }

    .product-price {
      font-weight: 600;
      font-size: 0.9rem;
      color: #a5b4fc;
    }

    .product-add {
      font-size: 0.8rem;
      border-radius: 999px;
      padding: 5px 10px;
      border: 1px solid #4b5563;
      background: #020617;
      color: #e5e7eb;
      cursor: pointer;
      transition: 0.15s;
    }

    .product-add:hover {
      background: #111827;
      border-color: #818cf8;
    }

    /* Cart */
    .cart {
      background: radial-gradient(circle at top, #020617, #020617);
      border-radius: 16px;
      border: 1px solid #111827;
      padding: 14px;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.8);
      font-size: 0.85rem;
    }

    .cart-title {
      font-weight: 600;
      margin-bottom: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .cart-items {
      max-height: 220px;
      overflow-y: auto;
      margin-bottom: 10px;
      padding-right: 4px;
    }

    .cart-item {
      display: flex;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 6px;
      border-bottom: 1px dashed #1f2937;
      padding-bottom: 4px;
    }

    .cart-item-name {
      font-size: 0.85rem;
    }

    .cart-item-controls {
      font-size: 0.82rem;
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .cart-btn {
      width: 20px;
      height: 20px;
      border-radius: 999px;
      border: 1px solid #4b5563;
      background: #020617;
      color: #e5e7eb;
      cursor: pointer;
      font-size: 0.75rem;
      padding: 0;
      line-height: 1;
    }

    .cart-summary {
      font-size: 0.85rem;
      color: #d1d5db;
      margin-bottom: 8px;
    }

    .cart-total {
      font-weight: 600;
      color: #22c55e;
    }

    .cart-subtotal {
      color: #e5e7eb;
    }

    .cart-discount-line {
      font-size: 0.8rem;
      color: #f97316;
    }

    .cart-note {
      font-size: 0.8rem;
      color: #9ca3af;
      margin-bottom: 8px;
    }

    /* Auth */
    .auth {
      background: radial-gradient(circle at top left, #020617, #020617);
      border-radius: 16px;
      border: 1px solid #111827;
      padding: 14px;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.75);
      font-size: 0.9rem;
    }

    .auth-tabs {
      display: flex;
      gap: 8px;
      margin-bottom: 10px;
      font-size: 0.8rem;
    }

    .auth-tab {
      padding: 4px 10px;
      border-radius: 999px;
      border: 1px solid #374151;
      background: #020617;
      color: #e5e7eb;
      cursor: pointer;
    }

    .auth-tab.active {
      border-color: #818cf8;
      background: #111827;
    }

    .form-group {
      margin-bottom: 8px;
    }

    label {
      display: block;
      margin-bottom: 3px;
      font-size: 0.82rem;
      color: #e5e7eb;
    }

    input,
    textarea {
      width: 100%;
      border-radius: 9px;
      border: 1px solid #374151;
      background: #020617;
      color: #e5e7eb;
      padding: 7px 9px;
      font-size: 0.85rem;
      outline: none;
      transition: 0.14s;
    }

    input:focus,
    textarea:focus {
      border-color: #6366f1;
      box-shadow: 0 0 0 1px rgba(129, 140, 248, 0.5);
    }

    textarea {
      min-height: 100px;
      resize: vertical;
    }

    /* Contact */
    .contact-box {
      background: radial-gradient(circle at top, #020617, #020617);
      border-radius: 16px;
      border: 1px solid #111827;
      padding: 14px;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.75);
      font-size: 0.85rem;
    }

    .contact-box p {
      margin-bottom: 6px;
    }

    .contact-box strong {
      color: #a5b4fc;
    }

    .social-links {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 6px;
      font-size: 0.8rem;
    }

    .social-pill {
      padding: 4px 9px;
      border-radius: 999px;
      border: 1px solid #374151;
      background: #020617;
    }

    .social-pill a {
      color: #e5e7eb;
    }

    /* Section visibility */
    [data-section] {
      transition: opacity 0.3s ease, transform 0.3s ease;
    }

    [data-section].hidden {
      display: none !important;
    }

    /* Footer */
    footer {
      border-top: 1px solid #111827;
      padding: 16px 0 22px 0;
      text-align: center;
      font-size: 0.78rem;
      color: #6b7280;
      background: #020617;
    }
  </style>
</head>
