<header>
  <div class="container">
    <div class="nav">
      <div class="logo" data-nav="home"><span>Matin</span> Mirzapour</div>

      <button class="nav-toggle" type="button" id="nav-toggle">
        <span>منو</span>
        <span class="nav-toggle-icon"></span>
      </button>

      <nav>
        <ul id="nav-menu">
          <li><a href="#home" data-nav="home" class="active">خانه</a></li>
          <li><a href="#store" data-nav="store">فروشگاه</a></li>
          <li><a href="#about" data-nav="about">درباره</a></li>
          <li><a href="#auth" data-nav="auth">ثبت‌نام / ورود</a></li>
